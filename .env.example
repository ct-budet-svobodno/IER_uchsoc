# Обязательно: токен Telegram-бота от @BotFather.
BOT_TOKEN=

# Опционально: Telegram ID пользователей, которым доступны админ-команды.
# Если админов несколько, разделяй ID запятыми: 123456789,987654321
ADMIN_IDS=

# Опционально: ID чата, группы или канала, куда бот будет пересылать вопросы пользователей.
# Для групп и каналов ID обычно отрицательный, например: -1001234567890
QUESTIONS_CHAT_ID=

# Опционально: ID чата, группы или канала, куда бот будет пересылать предложения пользователей.
SUGGESTIONS_CHAT_ID=

# Опционально: ID приватного канала или группы для хранения Telegram file_id мемов.
# Перед использованием добавь бота в этот чат.
MEME_STORAGE_CHAT_ID=

# Путь к SQLite-базе данных.
# В Docker этот путь сохраняется через volume ./data:/app/data.
DATABASE_URL=sqlite+aiosqlite:////app/data/bot_data.db